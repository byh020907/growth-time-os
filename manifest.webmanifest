{
  "id": "./",
  "name": "Growth Time OS",
  "short_name": "Growth OS",
  "description": "할 일을 한 줄 추가하고 NOW Todo부터 실행하는 강화된 개인 TodoList",
  "lang": "ko",
  "start_url": "./#now",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f6f2e9",
  "theme_color": "#1d2621",
  "orientation": "any",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "NOW Todo",
      "short_name": "NOW",
      "url": "./#now",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "할 일",
      "short_name": "할 일",
      "url": "./#plan",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "7일 기록",
      "short_name": "7일 기록",
      "url": "./#review",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
